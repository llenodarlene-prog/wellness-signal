# Wellness Signal: server settings (Apache / LiteSpeed on Hostinger)

# Serve the static homepage, never a leftover index.php.
DirectoryIndex index.html

# Don't serve pages from LiteSpeed's server-side page cache.
<IfModule LiteSpeed>
  CacheLookup off
</IfModule>

<IfModule mod_headers.c>
  # Pages and feeds: browsers and the CDN must re-check on every visit,
  # so new articles and edits appear immediately after a deploy.
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Styles and scripts are versioned by content hash: cache for a year.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images and icons: cache for 30 days.
  <FilesMatch "\.(webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /404.html
